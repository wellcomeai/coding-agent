# ===== Обязательные =====
# Домен, указывающий на IP сервера (Caddy сам выпустит HTTPS-сертификат)
DOMAIN=agent.example.ru
PUBLIC_URL=https://agent.example.ru
COOKIE_SECURE=true
POSTGRES_PASSWORD=сгенерируйте-длинный-пароль

# Fernet-ключ для шифрования токенов пользователей:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# Случайная строка для подписи cookie: openssl rand -hex 32
SESSION_SECRET=

# GitHub-логины администраторов через запятую (пополнение балансов)
ADMIN_GITHUB_LOGINS=your-github-login

# ===== GitHub App =====
# Проще всего создать автоматически: задайте SETUP_TOKEN (openssl rand -hex 16) и откройте
# https://ваш-домен/setup?token=<SETUP_TOKEN>. Тогда поля ниже можно оставить пустыми.
SETUP_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM целиком, переносы строк заменить на \n
GITHUB_PRIVATE_KEY=

# ===== LLM: Timeweb AI Gateway =====
AI_GATEWAY_BASE_URL=https://api.timeweb.ai/v1
# Ключ вида sk-... из панели Timeweb → AI Gateway
AI_GATEWAY_API_KEY=
# Модели для пользователей (как их называет gateway) и модель по умолчанию
AGENT_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.3-codex,moonshot/kimi-k2.7-code,deepseek/deepseek-v4-pro
DEFAULT_MODEL=anthropic/claude-sonnet-5

# ===== Биллинг =====
# Наш API-токен Timeweb Cloud — только для загрузки прайса моделей
TIMEWEB_API_TOKEN=
# Наценка считается автоматически: (1+маржа)(1+инфраструктура)/(1-комиссия-налог) ≈ 1.47
# PRICE_MARKUP=1.5   # задать вручную, если нужно
TARGET_MARGIN=0.25
PAYMENT_FEE=0.05
TAX_RATE=0.06
INFRA_OVERHEAD=0.05
SIGNUP_BONUS_RUB=0

# ===== Робокасса =====
# В личном кабинете Робокассы (Технические настройки) укажите:
#   Result URL:  https://ваш-домен/api/billing/robokassa/result   (POST)
#   Success URL: https://ваш-домен/api/billing/robokassa/success  (GET)
#   Fail URL:    https://ваш-домен/api/billing/robokassa/fail     (GET)
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_HASH=md5
ROBOKASSA_TEST=false
# Передавать чек (54-ФЗ), если магазин подключён к облачной кассе Робокассы
ROBOKASSA_RECEIPT=false
TOPUP_PACKAGES=300,1000,3000,10000

# ===== Песочницы =====
SANDBOX_MEMORY=2g
SANDBOX_CPUS=1.0
SANDBOX_IDLE_MINUTES=30
